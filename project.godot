[layer_names]

3d_physics/layer_1="world"
3d_physics/layer_2="player"
3d_physics/layer_3="enemies"
3d_physics/layer_4="projectiles"
3d_physics/layer_5="bodies"
3d_physics/layer_6="interactables"
3d_physics/layer_7="noise_triggers"
3d_physics/layer_8="hitboxes"

[debug]

gdscript/warnings/inferred_declaration=1
gdscript/warnings/untyped_declaration=0
gdscript/warnings/unsafe_method_access=1
gdscript/warnings/unsafe_property_access=1
gdscript/warnings/unsafe_cast=1
gdscript/warnings/return_value_discarded=0

[input_devices]

# Mouse-from-touch stays ON so every GUI Control (menus, gunsmith, sliders)
# responds to taps on mobile web/native. Gameplay fire/aim ignore mouse /
# emulated-mouse while the touch UI is active (see TouchInput), so look-swipes
# never shoot — only the on-screen Fire button does.
pointing/emulate_mouse_from_touch=true
pointing/emulate_touch_from_mouse=false

[navigation]

3d/merge_rasterizer_cell_scale=0.001

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/vram_compression/import_etc2_astc=true
anti_aliasing/quality/msaa_3d=0
lights_and_shadows/directional_shadow/size=2048
