; Engine configuration file.
; Godot 4.3 — Outpost Liberation stealth FPS prototype (PC + Mobile)

config_version=5

[application]

config/name="Outpost Liberation"
config/description="Far Cry–inspired first-person stealth outpost prototype"
run/main_scene="res://scenes/ui/main_menu.tscn"
config/features=PackedStringArray("4.3", "GL Compatibility")
config/icon="res://icon.svg"

[autoload]

GameState="*res://scripts/systems/game_state.gd"
NoiseBus="*res://scripts/systems/noise_bus.gd"
SaveManager="*res://scripts/systems/save_manager.gd"
TouchInput="*res://scripts/systems/touch_input.gd"
WebDisplay="*res://scripts/systems/web_display.gd"
GraphicsQuality="*res://scripts/systems/graphics_quality.gd"
DayNightCycle="*res://scripts/systems/day_night_cycle.gd"
ScreenshotRunner="*res://scripts/systems/screenshot_runner.gd"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation=4

